# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# Supabase (use service role key for write access)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=blog-covers

# Google Custom Search (for image fetching)
GOOGLE_CSE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# Community Links — injected into EVERY article
WHATSAPP_LINK=https://chat.whatsapp.com/your_link
TELEGRAM_CHANNEL=https://t.me/your_channel
TELEGRAM_GROUP=https://t.me/your_group
WEBSITE_URL=https://www.apnacounsellor.in
INSTAGRAM_URL=https://instagram.com/apnacounsellor
YOUTUBE_URL=https://youtube.com/@apnacounsellor
TWITTER_URL=https://twitter.com/apnacounsellor

# Agent Behaviour
AGENT_RUN_INTERVAL_HOURS=6
MAX_ARTICLES_PER_RUN=5
AUTO_PUBLISH=true
SCRAPE_DELAY_SECONDS=3
LOG_LEVEL=INFO

# API Auth
PORT=8000
AGENT_SECRET_KEY=your_secret_for_api_auth
